<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.threevits.holesquare"
    android:versionCode="4"
    android:versionName="1.0.3">

    <application
        android:label="挖孔黑方块"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <!-- ── 普通 app 的那一面：有图标、点得开 ── -->
        <!--
            锁竖屏不是偷懒：预览和「偏移量」都是按竖屏坐标算的。
            允许横屏的话，用户横着调出来的偏移值会被当成竖屏向量用，方向直接歪掉。
            锁死之后，app 里看到的、调的、模块用的，永远是同一套坐标。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="挖孔黑方块">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            把配置暴露给 SystemUI 里的 hook。必须 exported ——
            查询方是 SystemUI，跟本 app 不同 uid、不同签名，拿不到自定义权限。
            里面只有一个形状名字符串。
        -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.threevits.holesquare.config"
            android:exported="true" />

        <!-- ── LSPosed 模块的那一面 ── -->

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="在挖孔位置常驻一块黑形状（方形／五角星／圆角矩形／渐变横条，也能粘自己的 SVG），把圆孔视觉上变成所选形状。改完立刻生效，不用重启。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- 声明作用域，LSPosed 装上就自动勾上"系统界面" -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>
</manifest>
